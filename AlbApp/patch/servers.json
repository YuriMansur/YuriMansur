{
  "servers": [
    {
      "name": "PLC1",
      "endpoint": "opc.tcp://127.0.0.1:4840",
      "auto_reconnect": true,
      "reconnect_interval": 5,
      "ns": 4,
      "base": "|var|CODESYS Control Win V3 x64.Application.MAIN_VIRTUAL.API.",
      "index_enum": ["b_names", "c_names", "st_names"],
      "tags": {
        "b_names": "b_names",
        "c_names": "c_names",
        "s_names": "s_names",
        "st_names": "st_names",
        "initStatuses": "initStatuses",
        "general_fault": "initStatuses[GENERAL_FAULT]",
        "cc": "i_data",
        "tenzaSensorDataArr": "data_buffer[TENZA_ONE].value",
        "displacementSensorArr": "data_buffer[DISPLACEMENT_ONE].value",
        "nowSetpoint": "nowSetpoint",
        "max_array_length": "max_array_length",
        "cmd_status": "cmd_status",
        "cmdExperimentRun": "commands[EXPERIMENT_RUN]",
        "cmdExperimentEnd": "commands[EXPERIMENT_END]",
        "cmdExperimentAbort": "commands[EXPERIMENT_ABORT]",
        "cmdEnableDriver": "commands[EN_DRIVER]",
        "cmdDisableDriver": "commands[DIS_DRIVER]",
        "cmdResetFault": "commands[RESET_FAULT]",
        "cmdForwardJog": "commands[FW_JOG]",
        "cmdBackwardJog": "commands[BW_JOG]"
      },
      "subscribe": [
        "general_fault",
        "nowSetpoint"
      ],
      "polls": [
        {
          "name": "arrays",
          "interval": 0.1,
          "sequential": true,
          "tags": ["cc", "displacementSensorArr", "tenzaSensorDataArr", "cmd_status",
                   "initStatuses"]
        }
      ],
      "status": [
        {
          "array": "cmd_status",
          "enum": "s_names",
          "prefix": "st:"
        },
        {
          "array": "initStatuses",
          "enum": "st_names",
          "prefix": "st:"
        }
      ],
      "logging": {
        "index_tag": "cc",
        "record": {
          "start": ["cmdExperimentRun"],
          "stop":  ["cmdExperimentEnd", "cmdExperimentAbort"]
        },
        "ring": [
          {
            "tag": "tenzaSensorDataArr",
            "measurement": "tenza",
            "points_msg": "tenza",
            "raw_array_msg": "tenza_array",
            "scalar": "nowSetpoint",
            "scalar_measurement": "nowSetpoint",
            "scalar_msg": "setpoint"
          },
          {
            "tag": "displacementSensorArr",
            "measurement": "displacement",
            "points_msg": "displacement"
          }
        ]
      }
    }
  ]
}
