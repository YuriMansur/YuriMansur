{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Demo GUI (OpcUaBackend example)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/unified_backend_package/example_opcua_backend_gui.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Текущий файл",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}
