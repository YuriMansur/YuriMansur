{
  "servers": [
    {
      "name": "PLC1",
      "endpoint": "opc.tcp://192.168.6.6:4840",
      "auto_reconnect": true,
      "reconnect_interval": 5,
      "ns": 4,
      "base": "|var|Xinje-Cortex-Linux-SM-CNC.Application.MAIN.StandLogicEx.",
      "tags": [
        "cmdPowerOn",
        "cmdPowerOff",
        "cmdForwardJogging",
        "cmdBackwardJogging",
        "cmdChangeControlMode",
        "cc",
        "tenzaSensorDataArr",
        "displacementSensorArr",
        "nowSetpoint"
      ],
      "subscribe": [
        "cmdChangeControlMode",
        "cmdForwardJogging",
        "cmdBackwardJogging",
        "cmdPowerOn",
        "cmdPowerOff",
        "nowSetpoint"
      ],
      "polls": [
        {
          "name": "arrays",
          "interval": 0.1,
          "sequential": true,
          "tags": ["cc", "displacementSensorArr", "tenzaSensorDataArr"]
        }
      ],
      "logging": {
        "index_tag": "cc",
        "array_size": 50,
        "ring": [
          {
            "tag": "tenzaSensorDataArr",
            "measurement": "tenza",
            "points_msg": "tenza",
            "raw_array_msg": "tenza_array",
            "scalar": "nowSetpoint",
            "scalar_measurement": "nowSetpoint",
            "scalar_msg": "setpoint"
          },
          {
            "tag": "displacementSensorArr",
            "measurement": "displacement",
            "points_msg": "displacement"
          }
        ]
      }
    }
  ]
}
